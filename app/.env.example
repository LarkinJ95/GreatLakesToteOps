# Great Lakes Moving Totes — public website environment
# Copy to .env and fill in for your deployment. All values are PUBLIC
# (browser-visible); secrets live only in the ToteOps Workers environment.

# Base URL of the Great Lakes ToteOps public API (Cloudflare Workers).
# Leave empty to run with the built-in local simulation.
VITE_TOTEOPS_API_URL=

# Public API key for unauthenticated public endpoints (X-Api-Key header).
# Must be scoped to public routes only in the Workers API.
VITE_TOTEOPS_PUBLIC_KEY=

# Cloudflare Turnstile site key (spam protection on public forms).
VITE_TURNSTILE_SITE_KEY=

# Customer portal URL on the ToteOps app (agreement, payment, account).
VITE_PORTAL_URL=/login
