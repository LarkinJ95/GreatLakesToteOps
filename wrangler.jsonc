{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greatlakestoteops",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "glmt-db",
      "database_id": "eac30d97-4024-40a9-b8dc-90474b8986a9",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "glmt-documents"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "JOB_QUEUE", "queue": "glmt-jobs" }
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "17 6 * * *",
      "23 7 * * *",
      "41 1 * * *",
      "9 2 1 * *"
    ]
  },
  "vars": {
    "APP_NAME": "Great Lakes ToteOps",
    "APP_ENV": "production",
    "APP_BASE_URL": "https://toteops.greatlakesmovingtotes.com",
    "SESSION_TTL_HOURS": "12",
    "TURNSTILE_ENABLED": "true",
    "STRIPE_ENABLED": "true"
  },
  "env": {
    "preview": {
      "name": "great-lakes-toteops-preview",
      "vars": {
        "APP_ENV": "preview",
        "APP_BASE_URL": "https://great-lakes-toteops-preview.workers.dev",
        "TURNSTILE_ENABLED": "true",
        "STRIPE_ENABLED": "false"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glmt-db-preview",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "glmt-documents-preview" }
      ],
      "queues": {
        "producers": [{ "binding": "JOB_QUEUE", "queue": "glmt-jobs-preview" }]
      }
    },
    "staging": {
      "name": "great-lakes-toteops-staging",
      "vars": {
        "APP_ENV": "staging",
        "APP_BASE_URL": "https://staging.toteops.greatlakesmovingtotes.com",
        "TURNSTILE_ENABLED": "true",
        "STRIPE_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glmt-db-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "glmt-documents-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "JOB_QUEUE", "queue": "glmt-jobs-staging" }]
      }
    },
    "production": {
      "name": "great-lakes-toteops",
      "vars": {
        "APP_ENV": "production",
        "APP_BASE_URL": "https://toteops.greatlakesmovingtotes.com",
        "TURNSTILE_ENABLED": "true",
        "STRIPE_ENABLED": "true"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "glmt-db",
          "database_id": "eac30d97-4024-40a9-b8dc-90474b8986a9",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "DOCUMENTS", "bucket_name": "glmt-documents" }
      ],
      "queues": {
        "producers": [{ "binding": "JOB_QUEUE", "queue": "glmt-jobs" }]
      }
    }
  }
}
